LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=
PUBLIC_SITE_URL=http://localhost:3000
REVIEW_SECRET=

# Sentry (Stage 2 structured logging + error tracking)
# DSN is public (client-side safe); next.config exposes it to the browser.
# Auth token is build-time only.
# Scope: All environments for DSN/ORG/PROJECT; Production + Preview only for AUTH_TOKEN.
SENTRY_DSN=
SENTRY_ORG=jojoprohk
SENTRY_PROJECT=jojopro-web-test
SENTRY_AUTH_TOKEN=
